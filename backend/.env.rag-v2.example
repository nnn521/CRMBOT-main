# TEMPLATE ONLY: contains no credentials. Keep the filled copy OUTSIDE this repo.
# See docs/rag-v2/LOCAL_SETUP.md for Windows setup and explicit loading.
# Compose reads only RAG_V2_POSTGRES_*; all KNOWLEDGE_* values are host runtime
# settings, not containers added by this infrastructure-only Compose file.

# Required: >=32 cryptographically random bytes (e.g. 64 hex characters).
# No default password and no trust authentication.
RAG_V2_POSTGRES_PASSWORD=
RAG_V2_POSTGRES_PORT=55432

# Keep disabled until migration, model digest and runtime integration are checked.
RAG_V2_ENABLED=false
# Set explicitly to the NEW knowledge database; never reuse DATABASE_URL.
# Format: postgresql://rag_v2_owner:<URL_ENCODED_PASSWORD>@127.0.0.1:55432/crmbot_knowledge_v2
# Keep its port in sync with RAG_V2_POSTGRES_PORT. Use a plain psycopg DSN.
KNOWLEDGE_DATABASE_URL=

# Native Windows Ollama OR optional Compose --profile ollama, never both.
# No model download is triggered by this template or Compose startup.
KNOWLEDGE_OLLAMA_BASE_URL=http://127.0.0.1:11434
KNOWLEDGE_EMBEDDING_MODEL=bge-m3
# Fill the FULL sha256:... digest from /api/tags after an explicit manual pull.
KNOWLEDGE_EMBEDDING_REVISION=
KNOWLEDGE_EMBEDDING_DIMENSION=1024
KNOWLEDGE_HTTP_TIMEOUT_SECONDS=10
KNOWLEDGE_DATABASE_TIMEOUT_SECONDS=5

# Independent RAG v2 paid-call settings. Leave key empty until obtained securely.
# Official price/parameter verification: 2026-10-20 (links in LOCAL_SETUP.md).
# The adapter sends thinking={"type":"disabled"}; no invented thinking env flag.
# These settings do not change DEFAULT_MODEL or the old application's defaults.
KNOWLEDGE_API_KEY=
KNOWLEDGE_ANSWER_MODEL=deepseek-flash
KNOWLEDGE_BUDGET_CNY=50
KNOWLEDGE_INPUT_PER_MILLION_CNY=2
KNOWLEDGE_OUTPUT_PER_MILLION_CNY=8
# REQUIRED before paid use: absolute persistent path OUTSIDE the checkout,
# e.g. C:/Users/YOUR_USER/AppData/Local/CRMBOT/rag-v2/budget/deepseek-budget.sqlite3
# All RAG v2 paid callers must share this same file. Do not delete/reset it.
# If provider usage ever exceeds a reservation, the ledger halts further calls.
KNOWLEDGE_BUDGET_PATH=

# source_quotes_only = 完整原文摘录（最保守）
# synthesized = 单次综合回答，每条结论必须引用完整原文；仍需人工语义评测
KNOWLEDGE_ANSWER_MODE=source_quotes_only

# 可选本地 cross-encoder 重排（TEI /rerank，需显式部署模型）
KNOWLEDGE_RERANK_ENABLED=false
KNOWLEDGE_RERANK_BASE_URL=http://127.0.0.1:8081
KNOWLEDGE_RERANK_MODEL=
KNOWLEDGE_RERANK_TIMEOUT_SECONDS=0.3
