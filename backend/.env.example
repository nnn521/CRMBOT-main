# ==========================================
# 智能销售 AI Agent - 环境变量配置示例
# 复制此文件为 .env 并填写实际值
# ==========================================

# ========== 应用基础配置 ==========
APP_NAME=智能销售 AI Agent
APP_VERSION=1.0.0
DEBUG=false

# ========== 运行环境 ==========
# development 允许 FAISS 危险反序列化（仅本地调试）；
# 生产环境必须设置为 production（关闭危险反序列化）
ENVIRONMENT=development

# API 配置
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# CORS 配置（JSON 数组字符串）
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
# 生产环境示例：
# CORS_ORIGINS=["https://your-domain.com"]

# ========== 安全配置（必填）==========
# 必须替换为随机长字符串（至少 32 字符），例如：openssl rand -hex 32
# 占位值会被服务启动时拒绝
SECRET_KEY=replace-with-a-random-secret

# 可选：首次启动时创建管理员。创建完成后建议从 .env 删除这两项。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# ========== LLM 配置（OpenAI 兼容接口） ==========
OPENAI_API_KEY=sk-your-deepseek-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
DEFAULT_MODEL=deepseek-chat

# ========== 多模态配置（可选）==========
# 智谱 AI：GLM-4V 视觉识别 / CogView 图片生成，留空则多模态功能降级为文字引导
ZHIPU_API_KEY=

# ========== Hermes 内部助手（可选）==========
HERMES_API_URL=http://localhost:8642/v1
HERMES_API_KEY=

# ========== LangGraph 配置 ==========
MAX_ITERATIONS=10
AUTH_RATE_LIMIT=10
CHAT_RATE_LIMIT=30
REPORT_RATE_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=60

# ========== 知识库配置 ==========
# 路径不设置时默认使用 backend/data/ 下的绝对路径（不依赖启动目录）
# KNOWLEDGE_BASE_PATH=./data/knowledge_base
# VECTOR_STORE_PATH=./data/vector_store
EMBEDDING_MODEL=bge-m3
OLLAMA_BASE_URL=http://localhost:11434

# ========== 文档输出配置 ==========
# OUTPUT_DIR=./output

# ========== 日志配置 ==========
LOG_LEVEL=INFO
# 可选 json / 默认文本格式
LOG_FORMAT=json

# ========== PostgreSQL 数据库配置 ==========
# LangGraph 需要标准 postgresql:// DSN；SQLAlchemy 会在内部切换到 asyncpg。
# 未配置时 Agent 使用内存存储，但登录/会话持久化不可用。
DATABASE_URL=postgresql://crmbot:change-me@localhost:5432/crmbot
# docker compose 使用（postgres 服务密码）
POSTGRES_PASSWORD=replace-with-a-strong-database-password
