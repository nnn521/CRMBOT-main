# ==========================================
# 智能销售 AI Agent - 环境变量配置示例
# 复制此文件为 .env 并填写实际值
# ==========================================

# ========== 应用基础配置 ==========
APP_NAME=智能销售 AI Agent
APP_VERSION=1.0.0
DEBUG=true

# API 配置
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# CORS 配置（微信小程序域名）
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
# 生产环境示例：
# CORS_ORIGINS=["https://servicewechat.com", "https://your-domain.com"]

# ========== 安全配置 ==========
# 必须替换为随机长字符串，例如：openssl rand -hex 32
SECRET_KEY=replace-with-a-random-secret
INTERNAL_API_KEY=replace-with-a-second-random-secret

# 可选：首次启动时创建管理员。创建完成后建议删除这两项。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# ========== LLM 配置（OpenAI 兼容接口） ==========
OPENAI_API_KEY=sk-your-deepseek-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
DEFAULT_MODEL=deepseek-chat

# ========== LangGraph 配置 ==========
MAX_ITERATIONS=10
AUTH_RATE_LIMIT=10
CHAT_RATE_LIMIT=30
REPORT_RATE_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=60

# ========== 知识库配置 ==========
KNOWLEDGE_BASE_PATH=./data/knowledge_base
VECTOR_STORE_PATH=./data/vector_store
EMBEDDING_MODEL=bge-m3
OLLAMA_BASE_URL=http://localhost:11434

# ========== 文档输出配置 ==========
OUTPUT_DIR=./output

# ========== 日志配置 ==========
LOG_LEVEL=INFO
# 可选：DEBUG, INFO, WARNING, ERROR, CRITICAL

# ========== 微信小程序配置（预留） ==========
# WECHAT_APP_ID=your-wechat-app-id
# WECHAT_APP_SECRET=your-wechat-app-secret
# WECHAT_TOKEN_URL=https://api.weixin.qq.com/sns/jscode2session

# ========== PostgreSQL 数据库配置 ==========
# LangGraph 需要标准 postgresql:// DSN；SQLAlchemy 会在内部切换到 asyncpg。
DATABASE_URL=postgresql://crmbot:change-me@localhost:5432/crmbot
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# REDIS_URL=redis://localhost:6379/0
